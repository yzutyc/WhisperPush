# 数据库配置
DATABASE_URL=postgresql+asyncpg://user:password@localhost/whisperpush

# JWT 配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# FCM (Android) 配置
FCM_SERVER_KEY=

# APNs (iOS) 配置
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.yourapp.bundleid
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_USE_SANDBOX=true
